{
  "manifest_version": 3,
  "name": "ProxySwitch",
  "description": "Professional Proxy Manager. 专业的代理切换与规则管理工具。",
  "version": "7.5.0",
  "permissions": [
    "proxy", "storage", "tabs", "alarms", "webNavigation"
  ],
  "host_permissions": [
    "http://*/*", "https://*/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": "assets/icon.png"
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }

}
